camera2 = Camera('Camera2')
camera2.position = float3(8.38975525, 13.2182875, 10.3711815)
camera2.target = float3(7.91564655, 12.5599833, 9.78649712)
camera2.up = float3(0, 1, 0)
camera2.focalLength = 35
sceneBuilder.addCamera(camera2)



sceneBuilder.envMap = EnvMap('envmap/191_1k.hdr')
sceneBuilder.envMap.rotation = float3(193, 85, 0)
sceneBuilder.envMap.intensity = 2


