planeMat = Material('plane')
planeMat.baseColor = float4(0.2, 0.2, 0.3, 1.0)
planeMat.roughness = 0.2
planeMat.metallic = 0.1
planeMat.loadTexture(MaterialTextureSlot.BaseColor, f"textures/TilesMarbleCappuccinoBrickBondHoned001_COL_6K.jpg")
planeMat.loadTexture(MaterialTextureSlot.Normal, f"textures/TilesMarbleCappuccinoBrickBondHoned001_NRM_6K.jpg")

mtl1 = StandardMaterial('BTFMaterial1')
# mtl1.loadTexture(MaterialTextureSlot.Displacement, f"textures/white.png")
# mtl1.displacementScale = 0.1

quadRefMesh = TriangleMesh.createQuad()
refMeshID = sceneBuilder.addTriangleMesh(quadRefMesh, planeMat)
refNodeID = sceneBuilder.addNode('Ref', Transform(scaling=80, translation=float3(0, 0, 0), rotationEulerDeg=float3(0, 0, 0)))


neumatMesh = TriangleMesh.createFromFile('mesh/cylinder_soft.obj')
neumatMeshID = sceneBuilder.addTriangleMesh(neumatMesh, mtl1)
neumatNodeID = sceneBuilder.addNode('neumatMesh', Transform(scaling=20, translation=float3(0, 0, 0)))


#
sceneBuilder.addMeshInstance(neumatNodeID, neumatMeshID)
sceneBuilder.addMeshInstance(refNodeID, refMeshID)



